    "fable",
    "opus"
  ],
  "query": {
    "hashes": [
      "a0a1111",
      "b0b2222"
    ],
    "numbers": [
      171
    ],
    "lines": [
      "query($owner: String!, $name: String!) {",
      "  repository(owner: $owner, name: $name) {",
      "    c0: object(expression: \"a0a1111\") { ... on Commit { oid authoredDate } }",
      "    c1: object(expression: \"b0b2222\") { ... on Commit { oid authoredDate } }",
      "    i171: issue(number: 171) { timelineItems(itemTypes: [LABELED_EVENT, ASSIGNED_EVENT], first: 50) { nodes { __typename ... on LabeledEvent { createdAt label { name } } ... on AssignedEvent { createdAt } } } }",
      "  }",
      "}"
    ]
  },
