          "machine": "mini",
          "buckets": {
            "premium": 54
          }
        }
      ],
      "expect": {
        "buckets": {
          "general": null,
          "premium": {
            "percent": 54,
            "pace": 60,
            "gap": -6,
            "readingAt": "2026-11-10T17:10:00.000Z",
            "machine": "mini"
          }
        },
        "cachedAt": "2026-11-10T17:10:00.000Z",
        "renewsAt": "2026-11-10T21:10:00.000Z",
        "due": false
      }
    },
