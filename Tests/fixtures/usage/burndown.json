      "name": "no reading this week",
      "now": "2026-11-10T21:00:00.000Z",
      "cacheHours": 4,
      "entries": [],
      "expect": {
        "buckets": {
          "general": null,
          "premium": null
        },
        "cachedAt": null,
        "renewsAt": null,
        "due": false
      }
    },
    {
      "name": "one bucket typed, the other still none",
      "now": "2026-11-10T21:00:00.000Z",
      "cacheHours": 4,
