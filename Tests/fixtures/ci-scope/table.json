    { "event": "pull_request", "paths": ["docs/SCENARIOS.md"], "cli": false, "agent": false, "web": false, "contract": true, "why": "the scenario grid in words: scenarios.test.tsx cites it but does not read it, so the contract job alone" },
    { "event": "pull_request", "paths": ["docs/KNOWN-GAPS.md"], "cli": false, "agent": false, "web": false, "contract": true, "why": "the known gaps: DocCounts, Menu and Portability read it, all in the contract set" },
    { "event": "pull_request", "paths": ["docs/modules/deep/x.md"], "cli": true, "agent": true, "web": true, "contract": false, "why": "only the module documents themselves: a folder under docs/modules/ is shared" },
