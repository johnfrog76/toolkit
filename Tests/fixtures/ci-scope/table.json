    { "event": "pull_request", "paths": ["Web/src/App.tsx"], "cli": true, "agent": true, "web": true, "contract": false, "why": "case counts: Web/ is not web/, so it is unclassified" },
    { "event": "pull_request", "paths": ["samples/other/x.md"], "cli": true, "agent": true, "web": true, "contract": false, "why": "samples/ outside samples/hub/ is unclassified: everything" },
    { "event": "pull_request", "paths": ["web/src/App.tsx", "changelog.d/278.added.md"], "cli": false, "agent": false, "web": true, "contract": true, "why": "a mix of web/ and changelog.d/: the web, and the contracts for the CLI and the agent" },
    { "event": "pull_request", "paths": ["web/src/App.tsx", "docs/modules/studio.md", "docs/SCENARIOS.md", "changelog.d/280.changed.md"], "cli": false, "agent": false, "web": true, "contract": true, "why": "a web change that carries its documents and its changelog entry: web plus contract" },
    { "event": "pull_request", "paths": ["web/src/modules/deck/DeckPage.tsx", "docs/KNOWN-GAPS.md", "docs/modules/deck.md", "changelog.d/281.fixed.md"], "cli": false, "agent": false, "web": true, "contract": true, "why": "a gap fixed in a web-only module, its row removed, its document and its entry: web plus contract" },
    { "event": "pull_request", "paths": ["web/src/App.tsx", "docs/modules/studio.md", "docs/SCENARIOS.md", "changelog.d/280.changed.md", "docs/CLI.md"], "cli": true, "agent": true, "web": true, "contract": false, "why": "the same with docs/CLI.md: one shared path, all three" },
    { "event": "pull_request", "paths": ["web/src/App.tsx", "consts.json"], "cli": true, "agent": true, "web": true, "contract": false, "why": "a mix with one shared path: all three" },
    { "event": "pull_request", "paths": ["web/src/App.tsx", "notes.txt"], "cli": true, "agent": true, "web": true, "contract": false, "why": "a mix with one unknown path: all three" },
    { "event": "pull_request", "paths": ["  web/src/App.tsx  ", ""], "cli": false, "agent": false, "web": true, "contract": true, "why": "blank lines and padding in the list are not paths" }
