    { "event": "pull_request", "paths": ["CHANGELOG.md", "changelog.d/1.fixed.md"], "cli": false, "agent": false, "web": false, "contract": true, "why": "CHANGELOG.md and changelog.d/: the contract job alone (Changelog, DocCounts, Portability, the markdown lint)" },
    { "event": "pull_request", "paths": ["docs/modules/studio.md"], "cli": false, "agent": false, "web": false, "contract": true, "why": "a module document whose module has CLI and agent halves: no full suite asserts its text, so the contract job alone" },
