{
  "_comment": "docs/TESTING.md, \"In CI\": which of verify.yml's Ubuntu jobs a run needs. ONE table, read by Tests/Test-TestAll.ps1 through Get-P20CiScope (Scripts/TestAll-Rules.ps1). event is github.event_name; paths is the pull request's git diff --name-only; cli, agent, web and contract are the jobs that run. contract runs on a pull request that leaves a half out, and is the one job a changelog or prose path reaches.",
  "rows": [
    { "event": "push", "paths": [], "cli": true, "agent": true, "web": true, "contract": false, "why": "a push to main runs every half" },
    { "event": "workflow_dispatch", "paths": [], "cli": true, "agent": true, "web": true, "contract": false, "why": "the button runs every half" },
    { "event": "schedule", "paths": [], "cli": true, "agent": true, "web": true, "contract": false, "why": "a schedule answers every half (the workflow runs only Windows on it)" },
    { "event": "push", "paths": ["web/src/App.tsx"], "cli": true, "agent": true, "web": true, "contract": false, "why": "a push ignores its paths: every half" },
    { "event": "pull_request", "paths": [], "cli": true, "agent": true, "web": true, "contract": false, "why": "a pull request that lists no path runs everything" },
    { "event": "pull_request", "paths": ["web/src/App.tsx"], "cli": false, "agent": false, "web": true, "contract": true, "why": "web/ alone: the web job and the contracts" },
    { "event": "pull_request", "paths": ["web/src/shell/consts.ts", "web/public/art.png", "web/nginx.conf.template"], "cli": false, "agent": false, "web": true, "contract": true, "why": "anything under web/ is the web job's" },
    { "event": "pull_request", "paths": ["web/README.md"], "cli": false, "agent": false, "web": true, "contract": true, "why": "web/README.md: the web job, and the contracts hold the parity checks that read it" },
    { "event": "pull_request", "paths": ["agent/README.md"], "cli": true, "agent": true, "web": true, "contract": false, "why": "agent/README.md is under agent/: shared, all three" },
