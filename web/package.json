{
  "name": "toolkit-web",
  "version": "1.5.0",
  "description": "ToolKit web UI \u2014 a module shell over the ADO prompt-engineering module. React + Fluent UI, backed by the FastAPI agent.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:landing": "vite build --mode landing",
    "preview": "vite preview",
    "lint": "eslint src && prettier --check src",
    "lint:fix": "eslint src --fix",
    "lint:md": "cd .. && markdownlint-cli2 \"README.md\" \"*.md\" \"docs/**/*.md\" \"design/*.md\" \"spec/*.md\" \"web/README.md\" \"agent/README.md\"",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "type-check": "tsc --noEmit",
    "test": "node tests/viteconfig.mjs && jest",
    "test:config": "node tests/viteconfig.mjs",
    "smoke": "node tests/smoke.mjs",
    "smoke:modules": "node tests/smoke.mjs --modules=on",
    "smoke:mobile": "node tests/smoke.mjs --viewport=mobile",
    "smoke:landing": "node tests/smokeLanding.mjs",
    "smoke:studio": "node tests/smoke.mjs --studio",
    "smoke:matrix": "node tests/smoke.mjs --matrix",
    "smoke:a11y": "node tests/smoke.mjs --a11y",
    "smoke:first-run": "node tests/smoke.mjs --first-run",
    "license:check": "npx --yes license-checker@25.0.1 --production --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;MIT AND ISC\" --excludePrivatePackages --excludePackages \"tween-functions@1.2.0\" --summary",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@fluentui/keyboard-keys": "^9.0.9",
    "@fluentui/react-components": "^9.74.11",
    "@fluentui/react-icons": "^2.0.344",
    "@reduxjs/toolkit": "^2.13.0",
    "luxon": "^3.7.2",
    "react": "^19.3.1",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "markdownlint-cli2": "^0.24.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "eslint": "$eslint",
    "smol-toml": "^1.9.0",
    "katex": "^0.18.2",
    "markdown-it": ">=15.0.3",
    "test-exclude": "^8.0.0",
    "jsdom": "^30.0.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.1"
    },
    "re2js": "2.8.7"
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
