# nginx's config for the production image -- a TEMPLATE, not a config.
#
# The official nginx image runs envsubst over /etc/nginx/templates/*.template at
# container start and writes the result to /etc/nginx/conf.d/. That is how the
# agent's port gets here: docker-compose.yml passes P20_AGENT_PORT (the name is
# consts.json's env.agentPort; Start-Web.ps1 sets it from web.agentPort), and
# the entrypoint substitutes it below. This file used to say 4100.
#
# Only P20_* names are substituted (NGINX_ENVSUBST_FILTER in the Dockerfile), so
# nginx's own $host, $remote_addr and $uri are left exactly as written.

# The name the page is opened by must be this machine's. Anything else ends here.
server {
    listen 5173 default_server;
    return 444;
}

server {
    listen 5173;
    server_name localhost 127.0.0.1 [::1];
    root /usr/share/nginx/html;
    index index.html;

    # API calls -> FastAPI on the host, on the configured agent port
    location /api/ {
        proxy_pass http://host.docker.internal:${P20_AGENT_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 300s;
    }

    # SPA fallback. The agent sets these on what it answers; this is the page.
    # consts.json agent.responseHeaders, held to this file by Tests/test_consts.py.
    location / {
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'none'" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        try_files $uri $uri/ /index.html;
    }
}
